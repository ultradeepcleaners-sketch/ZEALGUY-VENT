rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE GLOBAL HELPERS ---
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }

    // --- ENTITY VALIDATION HELPERS ---

    // ContactSubmission Entity Validator
    function isValidContactSubmission(data) {
      return data.name is string 
        && data.name.size() >= 1 
        && data.name.size() <= 100
        && data.email is string 
        && data.email.size() >= 3 
        && data.email.size() <= 100
        && data.budget is string 
        && data.budget.size() <= 50
        && (!('launchDate' in data) || (data.launchDate is string && data.launchDate.size() <= 50))
        && (!('message' in data) || (data.message is string && data.message.size() <= 1000))
        && data.keys().hasAll(['name', 'email', 'budget'])
        && data.keys().size() <= 6;
    }

    // ChatMessage Entity Validator
    function isValidChatMessage(data) {
      return data.sender is string 
        && (data.sender == 'client' || data.sender == 'ai')
        && data.text is string 
        && data.text.size() >= 1 
        && data.text.size() <= 500
        && data.keys().hasAll(['sender', 'text'])
        && data.keys().size() <= 4;
    }

    // SaleLog Entity Validator
    function isValidSaleLog(data) {
      return data.customer is string 
        && data.customer.size() >= 1 
        && data.customer.size() <= 100
        && (data.amount is int || data.amount is float)
        && data.amount >= 0
        && data.type is string 
        && data.type.size() <= 100
        && data.keys().hasAll(['customer', 'amount', 'type'])
        && data.keys().size() <= 5;
    }

    // --- PATH MATCHING AND ACCESS CONTROLS ---

    // 1. Contact Submissions: Write-Only for public/guests
    match /contact_submissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidContactSubmission(incoming());
      allow get, list, update, delete: if false;
    }

    // 2. Chat Feed Messages: Read/Write for anyone participating in the sandbox/demo
    match /chats/{messageId} {
      allow create: if isValidId(messageId) && isValidChatMessage(incoming());
      allow list, get: if true;
      allow update, delete: if false; // Immutability guarantee
    }

    // 3. Platform Sales Telemetry: Read/Write for anyone participating in the sandbox/demo
    match /sales/{saleId} {
      allow create: if isValidId(saleId) && isValidSaleLog(incoming());
      allow list, get: if true;
      allow update, delete: if false; // Immutability guarantee
    }
  }
}
